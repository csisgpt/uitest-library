{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "lib": ["dom", "esnext"],
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      // اگر استفاده خاصی نداری، این‌ها را هم می‌توانی حذف کنی
      "ui-library": ["./index.ts"],
      "ui-library/*": ["./*"]
    },
    "skipLibCheck": true
  },
  "include": [
    "components/**/*.ts",
    "components/**/*.vue",
    "composables/**/*.ts",
    "theme/**/*.ts",
    "index.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.mts",
    "typings/css-modules.d.ts",
    "typings/vue-shim.d.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-types", "demo", "storybook-static", "types"]
}
