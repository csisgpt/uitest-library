{
  "name": "ui-library-csis",
  "version": "2.0.25",
  "description": "Vue 3 component library",
  "license": "MIT",
  "author": "Your Name",
  "homepage": "https://github.com/your/repo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your/repo.git",
    "directory": "ui-library"
  },
  "bugs": {
    "url": "https://github.com/your/repo/issues"
  },
  "main": "dist/ui-library.umd.js",
  "module": "dist/ui-library.es.js",
  "types": "dist-types/typings/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-types/typings/index.d.ts",
      "import": "./dist/ui-library.es.js",
      "require": "./dist/ui-library.umd.js",
      "default": "./dist/ui-library.es.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "dist-types",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^3.3.0",
    "@tabler/icons-vue": "^3.0.0"
  },
  "style": "dist/style.css",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vite build && vue-tsc -p tsconfig.types.json",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8"
  },
  "devDependencies": {
    "vue": "^3.3.0",
    "vue-tsc": "^2.0.22",
    "@tabler/icons-vue": "^3.0.0",
    "typescript": "^5.0.0",
    "@vitejs/plugin-vue": "^4.0.0",
    "vite": "^5.0.0",
    "@chromatic-com/storybook": "^4.0.1",
    "@storybook/addon-a11y": "^9.0.18",
    "@storybook/addon-actions": "^9.0.8",
    "@storybook/addon-docs": "^9.0.18",
    "@storybook/addon-onboarding": "^9.0.18",
    "@storybook/addon-vitest": "^9.0.18",
    "@storybook/vue3": "^7.0.0",
    "@storybook/vue3-vite": "^9.0.18",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "playwright": "^1.54.1",
    "storybook": "^9.0.18",
    "vitest": "^3.2.4"
  }
}
